{
  "name": "itsme",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Preserved samdickie.me reference clone for subsequent personalization",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "start": "node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "build:grapes": "npm run build --prefix personalization/grape-player",
    "audit": "node tools/audit.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tools/verify.mjs",
    "test:interactions": "node tools/interactions.mjs",
    "test:edges": "node tools/edge-cases.mjs",
    "subscribers:export": "node tools/export-subscribers.mjs",
    "messages:inbox": "node tools/messages-inbox.mjs",
    "capture:source": "python3 tools/capture.py",
    "build:sites": "node tools/prepare-sites.mjs && vinext build",
    "db:generate": "drizzle-kit generate",
    "dev:sites": "vinext dev --port 5173",
    "start:sites": "node --import ./hosting/scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --port 4173 --inspector-port 0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "next": "16.3.4",
    "drizzle-orm": "0.45.2"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
